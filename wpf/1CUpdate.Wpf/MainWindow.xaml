<Window x:Class="OneCUpdate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OneCUpdate.Converters"
        Title="1C Update 2.0 — обновление платформы 1С на компьютерах"
        Width="1480" Height="920" MinWidth="1160" MinHeight="720"
        Background="{StaticResource BgBrush}"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:HexBrushConverter x:Key="HexBrush"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringVis"/>
        <conv:InverseBooleanConverter x:Key="NotBool"/>

        <Style x:Key="KpiButton" TargetType="Button">
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A5A64"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ===================== Шапка ===================== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="30" Height="30"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="1C Update" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Массовое обновление платформы 1С через PsExec"
                                   Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ComputerCountText}" Style="{StaticResource MutedText}" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Потоков:" Style="{StaticResource MutedText}" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding ThreadsText, UpdateSourceTrigger=LostFocus}" Width="46"
                             TextAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Проверить пути" Command="{Binding CheckPathsCommand}"
                            ToolTip="Проверить каталоги, скрипт и PsExec; найти версии в каталоге дистрибутивов"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Контент ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="386" MinWidth="320"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель настроек -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,8,14,12">
                    <StackPanel>

                        <TextBlock Text="КОМПЬЮТЕРЫ" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>

                        <Grid>
                            <TextBox Text="{Binding Computers, UpdateSourceTrigger=PropertyChanged}"
                                     Height="128" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     ToolTip="Имена или IP компьютеров — по одному в строке"/>
                            <TextBlock Text="PC-001&#x0a;192.168.10.32" Style="{StaticResource HintText}"
                                       VerticalAlignment="Top" Margin="10,8,0,0"
                                       Visibility="{Binding Computers, Converter={StaticResource EmptyStringVis}}"/>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Из файла…" Command="{Binding LoadFromFileCommand}" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="Из AD…" Click="OnLoadFromAd" Margin="4,0,4,0"/>
                            <Button Grid.Column="2" Content="Очистить" Command="{Binding ClearComputersCommand}" Margin="4,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding ComputerCountText}"
                                       Style="{StaticResource MutedText}" Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock Text="ПАРАМЕТРЫ УСТАНОВКИ" Style="{StaticResource SectionHeader}" Margin="0,16,0,0"/>

                        <TextBlock Text="Дистрибутивы -dd" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox Text="{Binding DistribDir}" ToolTip="Каталог с папками вида 8.3.27.2342-64"/>
                            <TextBlock Text="\\server\share\distr\1c" Style="{StaticResource HintText}"
                                       Visibility="{Binding DistribDir, Converter={StaticResource EmptyStringVis}}"/>
                        </Grid>

                        <TextBlock Text="Логи -dl" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox Text="{Binding LogDir}" ToolTip="Куда каждый ПК пишет свой журнал"/>
                            <TextBlock Text="\\server\share\distr\1c\log" Style="{StaticResource HintText}"
                                       Visibility="{Binding LogDir, Converter={StaticResource EmptyStringVis}}"/>
                        </Grid>

                        <TextBlock Text="Скрипт" Style="{StaticResource FieldLabel}"/>
                        <ComboBox SelectedIndex="{Binding DeliveryIndex}">
                            <ComboBoxItem Content="копировать exe на ПК (psexec -c)"/>
                            <ComboBoxItem Content="выложить .ps1 на шару"/>
                            <ComboBoxItem Content="внешний .ps1 по пути"/>
                        </ComboBox>

                        <TextBlock Text="Путь .ps1" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox Text="{Binding ScriptPath}" IsEnabled="{Binding ScriptPathEditable}"
                                     ToolTip="Путь к 1C8InstallAndUninstall.ps1 на шаре"/>
                            <TextBlock Text="\\server\share\distr\1c\log\1C8InstallAndUninstall.ps1"
                                       Style="{StaticResource HintText}"
                                       Visibility="{Binding ScriptPath, Converter={StaticResource EmptyStringVis}}"/>
                        </Grid>

                        <TextBlock Text="PsExec.exe" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox Text="{Binding PsexecPath}" IsEnabled="{Binding PsexecPathEditable}"/>
                            <TextBlock Text="C:\inst\PsExec.exe" Style="{StaticResource HintText}"
                                       Visibility="{Binding PsexecPath, Converter={StaticResource EmptyStringVis}}"/>
                        </Grid>
                        <CheckBox Content="встроенный (распакуется автоматически)"
                                  IsChecked="{Binding UseEmbeddedPsexec}" Margin="0,6,0,0"/>

                        <TextBlock Text="Пользователь -u" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <TextBox Text="{Binding User}" ToolTip="DOMAIN\user или .\Administrator"/>
                            <TextBlock Text="DOMAIN\admin" Style="{StaticResource HintText}"
                                       Visibility="{Binding User, Converter={StaticResource EmptyStringVis}}"/>
                        </Grid>

                        <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PasswordBox" ToolTip="Пароль не сохраняется на диск"/>

                        <TextBlock Text="Установка -ip" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel>
                            <RadioButton Content="не ставить" GroupName="ip" IsChecked="{Binding InstallNo}" Margin="0,0,14,0"/>
                            <RadioButton Content="последнюю" GroupName="ip" IsChecked="{Binding InstallLast}" Margin="0,0,14,0"/>
                            <RadioButton Content="версия" GroupName="ip" IsChecked="{Binding InstallVersionSelected}" Margin="0,0,10,0"/>
                        </WrapPanel>
                        <ComboBox ItemsSource="{Binding AvailableVersions}"
                                  SelectedItem="{Binding InstallVersion}"
                                  IsEnabled="{Binding InstallVersionSelected}"
                                  Margin="0,4,0,0"/>

                        <TextBlock Text="Удаление -dp" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel>
                            <RadioButton Content="не удалять" GroupName="dp" IsChecked="{Binding DeleteNo}" Margin="0,0,12,0"/>
                            <RadioButton Content="кроме старшей" GroupName="dp" IsChecked="{Binding DeleteAel}" Margin="0,0,12,0"/>
                            <RadioButton Content="всё" GroupName="dp" IsChecked="{Binding DeleteAll}" Margin="0,0,12,0"/>
                            <RadioButton Content="версия" GroupName="dp" IsChecked="{Binding DeleteVersionSelected}" Margin="0,0,8,0"/>
                        </WrapPanel>
                        <ComboBox ItemsSource="{Binding AvailableVersions}"
                                  SelectedItem="{Binding DeleteVersion}"
                                  IsEnabled="{Binding DeleteVersionSelected}"
                                  Margin="0,4,0,0"/>

                        <TextBlock Text="Компоненты -iod" Style="{StaticResource FieldLabel}"/>
                        <CheckBox Content="Конфигуратор + все клиенты" IsChecked="{Binding DesignerAllClients}"
                                  ToolTip="DESIGNERALLCLIENTS=1 — конфигуратор и все клиенты"/>
                        <CheckBox Content="Тонкий клиент" IsChecked="{Binding ThinClient}"
                                  IsEnabled="{Binding ComponentsEditable}" Margin="0,4,0,0"/>
                        <CheckBox Content="Тонкий клиент (файловый)" IsChecked="{Binding ThinClientFile}"
                                  IsEnabled="{Binding ComponentsEditable}" Margin="0,4,0,0"/>

                        <CheckBox Content="только показать команды" IsChecked="{Binding DryRun}"
                                  Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- Правая панель -->
            <Grid Grid.Column="2" Margin="14,10,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- KPI -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="88">
                    <ItemsControl ItemsSource="{Binding KpiItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource KpiButton}" Width="176">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding Accent, Converter={StaticResource HexBrush}}"
                                                CornerRadius="2" Margin="8,10,0,10"/>
                                        <StackPanel Grid.Column="1" Margin="12,8,10,8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Вкладки -->
                <TabControl Grid.Row="1" Margin="0,8,0,0">
                    <TabItem Header="Результаты">
                        <DataGrid ItemsSource="{Binding Jobs}" SelectionMode="Single" IsReadOnly="True"
                                  AlternationCount="2" BorderThickness="0,1,0,0">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="Background" Value="{Binding RowBackground}"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ПК" Binding="{Binding Name}" Width="160"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StateText}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding StateBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Длительность" Binding="{Binding DurationText}" Width="110"/>
                                <DataGridTextColumn Header="Код" Binding="{Binding CodeText}" Width="70"/>
                                <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*"
                                                    ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Журнал">
                        <Border Background="{StaticResource ConsoleBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,1"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </TabItem>
                </TabControl>

                <!-- Панель выполнения -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶  Выполнить" Style="{StaticResource AccentButton}" Width="140"
                                Command="{Binding RunCommand}" ToolTip="Запустить обновление (F5)"/>
                        <Button Content="■  Стоп" Width="96" Margin="8,0,0,0"
                                Command="{Binding StopCommand}" ToolTip="Остановить выполнение (F6)"/>
                        <Button Content="Очистить вывод" Margin="8,0,0,0" Command="{Binding ClearLogCommand}"/>
                        <Button Content="Сохранить отчёт…" Margin="8,0,0,0" Command="{Binding SaveReportCommand}"/>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Value="{Binding Progress}" Maximum="{Binding ProgressMax}" Height="6"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource CaptionText}"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Статус-бар ===================== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}">
                    <Run Text="1C Update 2.0 · MIT · "/>
                    <Run Text="{Binding CheckSummary}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
