<Window x:Class="OneCUpdate.Views.AdDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OneCUpdate.Converters"
        Title="Добавить компьютеры из Active Directory"
        Width="820" Height="660" MinWidth="680" MinHeight="520"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Домен -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Домен:" Style="{StaticResource MutedText}" Margin="0,0,8,0"/>
            <Grid Grid.Column="1">
                <TextBox x:Name="DomainBox" ToolTip="Короткое имя (CONTOSO) или DNS (contoso.local). Пусто — текущий домен."/>
                <TextBlock Text="CONTOSO" Foreground="#5A5A64" Margin="10,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=DomainBox, Converter={StaticResource EmptyStringVis}}"/>
            </Grid>
            <Button Grid.Column="2" Content="Загрузить дерево" Margin="8,0,0,0" Click="OnLoadTree"/>
            <Button Grid.Column="3" Content="↻" Width="34" Margin="6,0,0,0" Click="OnLoadTree" ToolTip="Обновить"/>
        </Grid>

        <!-- Фильтр -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Имя содержит:" Style="{StaticResource MutedText}" Margin="0,0,8,0"/>
            <TextBox x:Name="MaskBox" Grid.Column="1" KeyDown="OnMaskKeyDown"/>
            <CheckBox x:Name="RecursiveBox" Grid.Column="2" Content="включая вложенные OU" IsChecked="True"
                      Margin="12,0,0,0" Checked="OnRecursiveChanged" Unchecked="OnRecursiveChanged"/>
            <Button Grid.Column="3" Content="Найти" Margin="10,0,0,0" Click="OnFind"/>
        </Grid>

        <!-- Дерево + список -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38*"/>
                <ColumnDefinition Width="62*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,6,0">
                <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0"
                          SelectedItemChanged="OnTreeSelectionChanged"/>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="4">
                <ListBox x:Name="ComputerList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="2,1"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource CaptionText}"
                   TextTrimming="CharacterEllipsis" Margin="0,8,0,0" Text=""/>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отметить все" Click="OnCheckAll"/>
            <Button Grid.Column="1" Content="Добавить выбранные" Style="{StaticResource AccentButton}"
                    Click="OnAdd" Margin="8,0,0,0"/>
            <Button Grid.Column="2" Content="Отмена" Click="OnCancel" Margin="8,0,0,0"/>
            <TextBlock Grid.Column="3" x:Name="CountText" Style="{StaticResource MutedText}" Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</Window>
